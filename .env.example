APP_NAME=WWF Polit-Assistant API
APP_VERSION=0.1.0
JWT_SECRET_KEY=replace-with-a-long-random-secret
SYNC_API_KEY=replace-with-a-separate-random-admin-key
# Daily sync start (HH:MM, Europe/Zurich); after the OpenParlData exports (~02:15 UTC)
SYNC_TIME=04:30
DATABASE_URL=postgresql+psycopg://polit_assistant:polit_assistant_dev@localhost:5433/polit_assistant
# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=WWF Polit-Assistant

# Public/frontend URL used in verification links
VERIFICATION_BASE_URL=http://localhost:8000

# Verification token lifetime
EMAIL_VERIFICATION_MINUTES=30

# Google OAuth web application (optional)
# Authorized redirect: VERIFICATION_BASE_URL/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database password used by docker-compose.yml (keep in sync with DATABASE_URL)
POSTGRES_PASSWORD=polit_assistant_dev

# Abuse protection for email and token endpoints (only disable in controlled tests)
RATE_LIMIT_ENABLED=true

# Demo-only test notifications; never enable for a production database
DEMO_MODE=false
DEMO_MAILBOX_URL=
